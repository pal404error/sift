# ── App ─────────────────────────────────────────────
APP_NAME=llm-search
LOG_LEVEL=INFO

# ── Vector store ────────────────────────────────────
# "memory" (dev/test) or "qdrant" (production)
SIFT_VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
SIFT_QDRANT_API_KEY=<set-me>
QDRANT_COLLECTION=llm_search
VECTOR_DIM=384

# ── Embedding provider ──────────────────────────────
# "fake" | "openai" | "ollama"
SIFT_EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
OLLAMA_EMBED_URL=http://localhost:11434

# ── LLM provider ────────────────────────────────────
# "fake" | "openai" | "anthropic" | "ollama"
SIFT_LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
SIFT_LLM_API_KEY=<set-me>
SIFT_ANTHROPIC_API_KEY=<set-me>
OLLAMA_URL=http://localhost:11434
LLM_TEMPERATURE=0.0

# ── Ingestion ──────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=64
MAX_PAGES_PER_INGEST=20
RESPECT_ROBOTS=true
MIN_CRAWL_INTERVAL=1.0

# ── Reranking ──────────────────────────────────────
SIFT_RERANKER=lexical
RERANK_MODEL=
RERANK_MULTIPLIER=2

# ── Hybrid retrieval (lexical + vector fusion) ────
# Enable to fuse dense-vector and lexical (BM25-lite) results.
SIFT_HYBRID=false
RRF_K=60
# Fusion strategy: "rrf" (rank fusion, robust default) or "weighted" (normalized score blend).
SIFT_HYBRID_MODE=rrf
# Weight on the vector signal when HYBRID_MODE=weighted (0.0=lexical-only, 1.0=vector-only).
SIFT_HYBRID_ALPHA=0.5

# ── Auth (enterprise) ──────────────────────────────
SIFT_REQUIRE_AUTH=false
AUTH_METHOD=apikey
SIFT_API_KEYS=admin:<set-me>,user:<set-me>
OIDC_ISSUER=<set-me>
OIDC_AUDIENCE=<set-me>
OIDC_ROLE_CLAIM=roles
AUDIT_LOG=audit.log
